# ==============================================
# Telegram Bot Configuration
# ==============================================
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ==============================================
# Redis Configuration
# ==============================================
UPSTASH_REDIS_URL=your_upstash_redis_url_here
REDIS_TTL=600

# ==============================================
# HuggingFace Configuration
# ==============================================
HF_TOKEN=your_huggingface_token_here
HF_SPACE=mingg93/fgoslib-qwen3
HF_API_NAME=/solve_problem
HF_TIMEOUT=180
HF_RETRIES=2
HF_MAX_RETRIES=5

# ==============================================
# Rate Limiting Settings
# ==============================================
# Bot rate limits (per user)
RATE_LIMIT_TASKS_PER_HOUR=10
RATE_LIMIT_TASKS_PER_DAY=50

# HF Worker rate limits (per user)
RATE_LIMIT_HF_PER_USER_HOUR=5
RATE_LIMIT_HF_PER_USER_DAY=20

# Render Service rate limits (per user)
RATE_LIMIT_RENDER_PER_USER_HOUR=10
RATE_LIMIT_RENDER_PER_USER_DAY=30

# ==============================================
# File Size Limits
# ==============================================
# Maximum file size for PDF in MB (default: 10MB)
MAX_FILE_SIZE_MB=10

# Maximum images per task
MAX_IMAGES=5

# Maximum prompt length in characters
MAX_PROMPT_LEN=1000

# ==============================================
# S3 Storage (Optional)
# ==============================================
# If not configured, files will be stored in Redis (base64)
# S3_BUCKET=your_bucket_name
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_ENDPOINT=https://s3.amazonaws.com

# ==============================================
# Monitoring
# ==============================================
MONITOR_BASE_URL=

# ==============================================
# Worker Configuration
# ==============================================
WORKER_CONCURRENCY=3

# ==============================================
# Port Configuration (for Render.com deployment)
# ==============================================
PORT=10000
HTTP_PORT=8080
