FROM python:3.12-slim

LABEL maintainer="fgoslib"

WORKDIR /app

# Install ca-certificates for TLS/HTTPS connections
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY requirements.monitor.txt /app/requirements.monitor.txt
RUN pip install --no-cache-dir -r /app/requirements.monitor.txt

# Copy application code and static files
COPY monitor_backend.py /app/
COPY monitor.html /app/
COPY static/ /app/static/

ENV PYTHONUNBUFFERED=1

# Flask server runs on PORT (default 8080)
ENV PORT=8080
EXPOSE 8080

CMD ["python", "monitor_backend.py"]
