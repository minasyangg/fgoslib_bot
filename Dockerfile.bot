FROM python:3.12-slim

LABEL maintainer="fgoslib"

WORKDIR /app

# Install ca-certificates for TLS/HTTPS connections
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY requirements.bot.txt /app/requirements.bot.txt
RUN pip install --no-cache-dir -r /app/requirements.bot.txt

# Copy application code
COPY my_bot.py /app/

ENV PYTHONUNBUFFERED=1

# Flask health-check server runs on PORT (default 10000)
ENV PORT=10000
EXPOSE 10000

CMD ["python", "my_bot.py"]
